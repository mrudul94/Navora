# Cloudflare Pages response headers.

# ===========================================================================
# LAUNCH STEP: remove the X-Robots-Tag line below before going live.
#
# It is here because the site is deployed while photography and several
# business details are still outstanding. Without it, search engines could
# index a placeholder version of Navora's site at the .pages.dev address.
# Delete that one line once the site is complete and the real domain is
# connected. Nothing else in this file needs to change.
# ===========================================================================

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets and fonts never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the enquiry endpoint.
/api/*
  Cache-Control: no-store
