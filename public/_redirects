# Cloudflare Pages redirects. Rules are matched top to bottom and the first
# match wins, so keep specific rules above general ones.
#
# /api/* is handled by functions/ and is excluded from this file by
# _routes.json.

# Legacy paths from the previous site.
/sustainability     /responsible-sourcing   301
/wholesale          /for-business           301
/privacy-policy     /privacy-notice         301
/terms-conditions   /website-terms          301

# The blank route reported before handover.
/c                  /                       301

# No SPA catch-all: every route is prerendered to its own HTML file
# (scripts/prerender.mjs), and Cloudflare Pages always applies _redirects
# before static files, so a "/* /index.html 200" rule would serve the Home
# page markup for every URL. Unknown paths get dist/404.html with a 404.
