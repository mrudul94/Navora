{
  "name": "navora-global-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/generate-image-variants.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "smoke:render": "node scripts/smoke-render.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke": "npm run smoke:render && npm run smoke:client",
    "audit": "node scripts/audit.mjs",
    "verify": "npm run lint && npm run audit && npm run smoke && npm run build",
    "db:migrate": "wrangler d1 migrations apply navora-enquiries --remote",
    "db:migrate:local": "wrangler d1 migrations apply navora-enquiries --local",
    "enquiries": "wrangler d1 execute navora-enquiries --remote --command \"SELECT submitted_at, form, name, company, email, country FROM enquiries ORDER BY submitted_at DESC LIMIT 50\"",
    "deploy": "npm run verify && wrangler pages deploy dist --project-name navora-global --branch main --commit-dirty=true",
    "cf:dev": "wrangler pages dev dist",
    "images": "node scripts/generate-image-variants.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@sanity/client": "^7.13.0",
    "@sanity/image-url": "^1.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "vite": "^8.0.4",
    "wrangler": "^4.135.0"
  }
}
